<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>CMR &amp; Zlecenie Transportowe — Generator Edukacyjny</title>
<style>
  :root {
    --bg-app: #eef2f6;
    --bg-surface: #ffffff;
    --ink: #0f172a;
    --muted: #475569;
    --border: #cbd5e1;
    --brand: #1e3a8a;
    --brand-dark: #0f172a;
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg-app);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.3;
  }

  /* Górny pasek logo */
  .top-brand-bar {
    background: #0f172a;
    color: #ffffff;
    padding: 7px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .brand-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-oval {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 12px;
    border: 2px solid #ffffff;
    border-radius: 999px;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: #ffffff;
  }

  .brand-name {
    font-size: 13px;
    font-weight: 700;
  }

  .brand-meta {
    font-size: 11px;
    color: #cbd5e1;
  }

  /* Pasek nawigacji i akcji */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: #ffffff;
    border-bottom: 1px solid var(--border);
    padding: 9px 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .nav-tabs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f1f5f9;
    padding: 4px;
    border-radius: 7px;
    border: 1px solid #cbd5e1;
  }

  .nav-tab {
    border: none;
    background: transparent;
    color: #334155;
    padding: 6px 13px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .nav-tab.active {
    background: var(--brand);
    color: #ffffff;
  }

  .nav-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .btn {
    border: 1px solid #94a3b8;
    background: #ffffff;
    color: #0f172a;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .btn:hover {
    background: #f8fafc;
  }

  .btn-primary {
    background: var(--brand);
    border-color: var(--brand);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #172554;
  }

  .btn-clear {
    border-color: #dc2626;
    color: #b91c1c;
    background: #fef2f2;
  }

  .btn-clear:hover {
    background: #fee2e2;
  }

  .copy-select {
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid #94a3b8;
    font-size: 13px;
    font-weight: 600;
    background: #ffffff;
    color: #0f172a;
  }

  /* Główny układ: lewy panel edycji + prawy podgląd A4 */
  .main-grid {
    display: grid;
    grid-template-columns: minmax(360px, 445px) minmax(0, 1fr);
    gap: 18px;
    padding: 16px 18px 36px;
    align-items: start;
  }

  @media (max-width: 1120px) {
    .main-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-panel {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  }

  .form-group-card {
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    padding: 10px 11px;
    margin-bottom: 11px;
    background: #f8fafc;
  }

  .form-group-title {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--brand);
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .row-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 8px;
  }

  .row-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 8px;
  }

  .row-1 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-bottom: 8px;
  }

  .inp-box {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .inp-box label {
    font-size: 11px;
    font-weight: 700;
    color: #334155;
  }

  .inp-box input,
  .inp-box textarea,
  .inp-box select {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 6px 8px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #0f172a;
    background: #ffffff;
  }

  .inp-box textarea {
    min-height: 50px;
    resize: vertical;
  }

  .item-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 8px;
  }

  .item-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
    color: #475569;
    margin-bottom: 6px;
  }

  .totals-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
    margin-top: 6px;
  }

  .total-pill {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 6px 8px;
  }

  .total-pill .k {
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
  }

  .total-pill .v {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    margin-top: 2px;
  }

  .pad-wrap {
    border: 1px dashed #64748b;
    border-radius: 6px;
    background: #ffffff;
    padding: 6px;
  }

  canvas.pad {
    width: 100%;
    height: 78px;
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    background: #ffffff;
    touch-action: none;
    cursor: crosshair;
  }

  .pad-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 5px;
    font-size: 11px;
    color: #475569;
  }

  /* Panel podglądu na żywo */
  .preview-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  /* =====================================================================
     ARKUSZ A4 — LIST PRZEWOZOWY CMR (4 KOLOROWE EGZEMPLARZE)
     ===================================================================== */
  .cmr-page {
    --accent-cmr: #c62828;
    --tint-cmr: #fdecec;
    --soft-cmr: #fff8f8;
    width: 210mm;
    min-height: 297mm;
    background: #ffffff;
    border: 2px solid var(--accent-cmr);
    padding: 4.5mm 5mm;
    color: #0f172a;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.12);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cmr-page.egz-2 {
    --accent-cmr: #1565c0;
    --tint-cmr: #e8f1fc;
    --soft-cmr: #f5f9ff;
  }

  .cmr-page.egz-3 {
    --accent-cmr: #2e7d32;
    --tint-cmr: #e9f6ea;
    --soft-cmr: #f4fbf5;
  }

  .cmr-page.egz-4 {
    --accent-cmr: #111111;
    --tint-cmr: #eceef1;
    --soft-cmr: #f8f9fa;
  }

  .cmr-top-strip {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 5px;
    margin-bottom: 3.5px;
    font-size: 6.3pt;
    line-height: 1.15;
  }

  .cmr-strip-box {
    border: 1.2px solid var(--accent-cmr);
    background: var(--soft-cmr);
    padding: 2px 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 5px;
  }

  .cmr-strip-tag {
    border: 1.5px solid var(--accent-cmr);
    background: #ffffff;
    color: var(--accent-cmr);
    padding: 1px 5px;
    font-weight: 800;
    font-size: 6.4pt;
    white-space: nowrap;
  }

  .cmr-head {
    display: grid;
    grid-template-columns: 1.48fr 0.86fr;
    border: 1.8px solid var(--accent-cmr);
    margin-bottom: 3.5px;
  }

  .cmr-head-left {
    padding: 3.5px 6px;
    border-right: 1.5px solid var(--accent-cmr);
  }

  .cmr-head-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cmr-oval-badge {
    border: 2.2px solid var(--accent-cmr);
    border-radius: 999px;
    padding: 1px 10px;
    font-size: 11.5pt;
    font-weight: 900;
    color: var(--accent-cmr);
    background: #ffffff;
  }

  .cmr-main-h1 {
    font-size: 10.5pt;
    font-weight: 900;
    color: var(--accent-cmr);
    margin: 0;
    line-height: 1.1;
  }

  .cmr-main-sub {
    font-size: 6pt;
    font-weight: 700;
    color: #1e293b;
  }

  .cmr-conv-note {
    font-size: 5.8pt;
    line-height: 1.16;
    color: #1f2937;
    border-top: 0.8px solid var(--accent-cmr);
    margin-top: 2.5px;
    padding-top: 2px;
  }

  .cmr-head-right {
    background: var(--tint-cmr);
    padding: 3.5px 6px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cmr-num-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.2px solid var(--accent-cmr);
    padding-bottom: 2px;
    font-size: 7.4pt;
    font-weight: 900;
    color: var(--accent-cmr);
  }

  .cmr-copy-box {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }

  .cmr-copy-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent-cmr);
    color: #ffffff;
    font-size: 9pt;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cmr-copy-name {
    font-size: 7pt;
    font-weight: 900;
    color: var(--accent-cmr);
    line-height: 1.15;
  }

  .cmr-copy-desc {
    font-size: 5.9pt;
    color: #1e293b;
  }

  .cmr-upper-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-left: 1.5px solid var(--accent-cmr);
    border-top: 1.5px solid var(--accent-cmr);
  }

  .cmr-upper-col {
    display: flex;
    flex-direction: column;
  }

  .cmr-cell {
    border-right: 1.5px solid var(--accent-cmr);
    border-bottom: 1.5px solid var(--accent-cmr);
    padding: 2.5px 5px;
    overflow: hidden;
    background: #ffffff;
  }

  .cmr-cell.carrier-box {
    border-right: 2.6px solid var(--accent-cmr);
    border-top: 2.4px solid var(--accent-cmr);
    border-bottom: 2.4px solid var(--accent-cmr);
    background: var(--soft-cmr);
  }

  .cmr-cell.carrier-box + .cmr-cell.carrier-box {
    border-top: none;
  }

  .cmr-cell-head {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    margin-bottom: 1.5px;
  }

  .cmr-idx {
    background: var(--accent-cmr);
    color: #ffffff;
    font-size: 6.6pt;
    font-weight: 800;
    padding: 0.5px 3.5px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .cmr-cap {
    font-size: 6.1pt;
    line-height: 1.12;
    color: #1e293b;
  }

  .cmr-cap strong {
    color: var(--accent-cmr);
  }

  .cmr-input {
    width: 100%;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9pt;
    font-weight: 700;
    color: #0f172a;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
    resize: none;
    outline: none;
  }

  .h-1-2 { height: 26.5mm; }
  .h-3-5 { height: 18mm; }
  .h-16 { height: 24mm; }
  .h-17 { height: 17.5mm; }
  .h-18 { height: 21.5mm; }
  .h-19 { height: 20.5mm; }

  .cmr-goods-tbl {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    border-left: 1.5px solid var(--accent-cmr);
    border-right: 1.5px solid var(--accent-cmr);
    border-bottom: 1.5px solid var(--accent-cmr);
    margin-top: 2.5px;
  }

  .cmr-goods-tbl th,
  .cmr-goods-tbl td {
    border: 1px solid var(--accent-cmr);
    padding: 2px 3.5px;
    vertical-align: top;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .cmr-goods-tbl th {
    font-size: 5.8pt;
    line-height: 1.1;
    background: var(--tint-cmr);
    font-weight: 700;
  }

  .cmr-goods-tbl td {
    height: 10.6mm;
    background: #ffffff;
  }

  .cmr-goods-inp {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 8.5pt;
    font-weight: 600;
    color: #0f172a;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
    resize: none;
    outline: none;
  }

  .cmr-lower-grid {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    border-left: 1.5px solid var(--accent-cmr);
    border-right: 1.5px solid var(--accent-cmr);
    border-bottom: 1.5px solid var(--accent-cmr);
    margin-top: 2.5px;
  }

  .cmr-lower-left {
    border-right: 1.5px solid var(--accent-cmr);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cmr-lower-row {
    border-bottom: 1px solid var(--accent-cmr);
    padding: 2px 5px;
    min-height: 9.5mm;
  }

  .cmr-lower-row:last-child {
    border-bottom: none;
  }

  .cmr-lower-right {
    border-left: 2.5px solid var(--accent-cmr);
    background: var(--soft-cmr);
    padding: 2.5px 4px;
  }

  .cmr-pay-tbl {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 5.9pt;
    background: #ffffff;
  }

  .cmr-pay-tbl th,
  .cmr-pay-tbl td {
    border: 1px solid var(--accent-cmr);
    padding: 2px 3px;
    height: 5.2mm;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .cmr-pay-tbl th {
    background: var(--tint-cmr);
    font-weight: 800;
  }

  .cmr-signs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-left: 1.5px solid var(--accent-cmr);
    border-right: 1.5px solid var(--accent-cmr);
    border-bottom: 1.8px solid var(--accent-cmr);
    margin-top: 2.5px;
    min-height: 27mm;
  }

  .cmr-sign-box {
    border-right: 1px solid var(--accent-cmr);
    padding: 2.5px 5px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
  }

  .cmr-sign-box.carrier-box {
    border: 2.6px solid var(--accent-cmr);
    background: var(--soft-cmr);
  }

  .cmr-sign-box:last-child {
    border-right: none;
  }

  .sig-preview-img {
    max-height: 14mm;
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 2px auto 0;
  }

  /* =====================================================================
     ARKUSZ A4 — ZLECENIE TRANSPORTU DROGOWEGO
     ===================================================================== */
  .order-page {
    width: 210mm;
    min-height: 297mm;
    background: #ffffff;
    border: 1.5px solid #1e293b;
    padding: 7mm 8mm;
    color: #0f172a;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.12);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 8.5pt;
  }

  .ord-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2px solid #0f172a;
    padding-bottom: 5px;
    margin-bottom: 6px;
  }

  .ord-title {
    font-size: 14.5pt;
    font-weight: 900;
    margin: 0;
  }

  .ord-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 6px;
  }

  .ord-card {
    border: 1px solid #475569;
    padding: 5px 7px;
    background: #ffffff;
  }

  .ord-card-title {
    font-size: 7.4pt;
    font-weight: 800;
    text-transform: uppercase;
    color: #1e3a8a;
    border-bottom: 1px solid #cbd5e1;
    padding-bottom: 2px;
    margin-bottom: 4px;
  }

  .ord-tbl {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 7.8pt;
  }

  .ord-tbl th,
  .ord-tbl td {
    border: 1px solid #475569;
    padding: 4px 5px;
    vertical-align: top;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .ord-tbl th {
    background: #f1f5f9;
    font-weight: 800;
    text-align: left;
  }

  .ord-bottom-calc {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6px;
    margin-bottom: 6px;
  }

  .ord-vat-tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 8pt;
  }

  .ord-vat-tbl th,
  .ord-vat-tbl td {
    border: 1px solid #475569;
    padding: 4px 6px;
  }

  .ord-vat-tbl th {
    background: #f8fafc;
    text-align: left;
    width: 55%;
  }

  .ord-signs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .ord-sign-box {
    border: 1px solid #475569;
    padding: 6px 8px;
    min-height: 35mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ord-foot {
    margin-top: 6px;
    padding-top: 4px;
    border-top: 1px solid #cbd5e1;
    display: flex;
    justify-content: space-between;
    font-size: 7pt;
    color: #475569;
  }

  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }

    html, body {
      background: #ffffff !important;
      margin: 0 !important;
      padding: 0 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .top-brand-bar,
    .nav-bar,
    .form-panel {
      display: none !important;
    }

    .main-grid {
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .preview-col {
      display: block !important;
      gap: 0 !important;
    }

    .cmr-page,
    .order-page {
      box-shadow: none !important;
      margin: 0 !important;
      width: 210mm !important;
      min-height: 297mm !important;
      page-break-after: always;
      break-after: page;
    }

    .cmr-page:last-child,
    .order-page:last-child {
      page-break-after: auto;
      break-after: auto;
    }
  }
</style>
</head>
<body>

  <!-- Pasek logo -->
  <div class="top-brand-bar">
    <div class="brand-left">
      <span class="logo-oval">CMR</span>
      <div>
        <div class="brand-name">CMR &amp; Zlecenie Transportowe — Generator Edukacyjny</div>
        <div class="brand-meta">Format A4 • 4 egzemplarze CMR + Zlecenie transportowe • Podgląd na żywo</div>
      </div>
    </div>
    <span class="brand-meta">PL / DE / EN</span>
  </div>

  <!-- Pasek narzędzi -->
  <div class="nav-bar">
    <div class="nav-tabs">
      <button type="button" class="nav-tab active" id="btnTabCmr" onclick="setMode('cmr')">
        List przewozowy CMR (4 egz.)
      </button>
      <button type="button" class="nav-tab" id="btnTabOrder" onclick="setMode('order')">
        Zlecenie transportowe
      </button>
    </div>

    <div class="nav-actions">
