  window.handleVatSelect = function() {
    const sel = document.getElementById("f_ord_vat_sel").value;
    const customInp = document.getElementById("f_ord_vat_inp");
    if (sel === "custom") {
      customInp.disabled = false;
      appState.order.ord_vat = customInp.value || "23";
    } else if (sel === "np") {
      customInp.disabled = true;
      appState.order.ord_vat = "np";
    } else {
      customInp.disabled = true;
      customInp.value = sel;
      appState.order.ord_vat = sel;
    }
    calcVatSummary();
  };

  window.calcVatSummary = function() {
    const net = toNum(appState.order.ord_net);
    const sel = document.getElementById("f_ord_vat_sel")?.value || "23";
    let vatVal = 0;
    let lbl = "VAT (23%)";

    if (sel === "np") {
      vatVal = 0;
      lbl = "VAT (NP)";
    } else {
      const rate = sel === "custom" ? toNum(document.getElementById("f_ord_vat_inp")?.value) : toNum(sel);
      appState.order.ord_vat = String(rate);
      vatVal = net * (rate / 100);
      lbl = `VAT (${rate}%)`;
    }

    const gross = net + vatVal;

    document.getElementById("uiOrdNet").textContent = fmtNum(net) + " PLN";
    document.getElementById("uiOrdVatLbl").textContent = lbl;
    document.getElementById("uiOrdVat").textContent = fmtNum(vatVal) + " PLN";
    document.getElementById("uiOrdGross").textContent = fmtNum(gross) + " PLN";

    const pNet = document.getElementById("pOrdNet");
    const pVatLbl = document.getElementById("pOrdVatLbl");
    const pVat = document.getElementById("pOrdVat");
    const pGross = document.getElementById("pOrdGross");
    if (pNet) pNet.textContent = fmtNum(net) + " PLN";
    if (pVatLbl) pVatLbl.textContent = lbl;
    if (pVat) pVat.textContent = fmtNum(vatVal) + " PLN";
    if (pGross) pGross.textContent = fmtNum(gross) + " PLN";
  };

