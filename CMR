  function wireInputs() {
    document.querySelectorAll("[data-cmr]").forEach((el) => {
      const k = el.getAttribute("data-cmr");
      if ("value" in el) {
        if (el.value !== appState.cmr[k]) el.value = appState.cmr[k];
        el.oninput = function() {
          appState.cmr[k] = this.value;
          document.querySelectorAll(`[data-cmr="${k}"]`).forEach((peer) => {
            if (peer !== this && "value" in peer) peer.value = this.value;
          });
          runAutoFit();
        };
      }
    });

    document.querySelectorAll("[data-ord]").forEach((el) => {
      const k = el.getAttribute("data-ord");
      if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") {
        if (el.value !== appState.order[k]) el.value = appState.order[k];
        el.oninput = function() {
          appState.order[k] = this.value;
          document.querySelectorAll(`[data-ord="${k}"]`).forEach((peer) => {
            if (peer !== this) {
              if ("value" in peer) peer.value = this.value;
              else peer.textContent = this.value;
            }
          });
          if (k === "ord_net") calcVatSummary();
          runAutoFit();
        };
      } else {
        el.textContent = appState.order[k];
      }
    });
  }

  function initPad(canvasId, propName) {
    const c = document.getElementById(canvasId);
    if (!c) return;
    const ctx = c.getContext("2d");
    ctx.strokeStyle = "#0f172a";
    ctx.lineWidth = 2;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";

    let active = false;
    let lx = 0;
    let ly = 0;

    function pt(ev) {
      const r = c.getBoundingClientRect();
      const cx = ev.touches ? ev.touches[0].clientX : ev.clientX;
      const cy = ev.touches ? ev.touches[0].clientY : ev.clientY;
      return { x: ((cx - r.left) / r.width) * c.width, y: ((cy - r.top) / r.height) * c.height };
    }

    function down(ev) {
      ev.preventDefault();
      active = true;
      const p = pt(ev);
      lx = p.x;
      ly = p.y;
    }

    function move(ev) {
      if (!active) return;
      ev.preventDefault();
      const p = pt(ev);
      ctx.beginPath();
      ctx.moveTo(lx, ly);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      lx = p.x;
      ly = p.y;
    }

    function up() {
      if (!active) return;
      active = false;
      appState[propName] = c.toDataURL("image/png");
      if (propName === "cmrSig") drawCmrPages();
      else drawOrderPage();
    }

    c.addEventListener("mousedown", down);
    c.addEventListener("mousemove", move);
    window.addEventListener("mouseup", up);
    c.addEventListener("touchstart", down, { passive: false });
    c.addEventListener("touchmove", move, { passive: false });
    window.addEventListener("touchend", up);
  }

  window.wipePad = function(which) {
    if (which === "cmr") {
      const c = document.getElementById("padCmr");
      if (c) c.getContext("2d").clearRect(0, 0, c.width, c.height);
