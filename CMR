<script>
(function() {
  const COPIES = [
    { n: 1, cls: "egz-1", name: "EGZEMPLARZ DLA NADAWCY", desc: "Exemplar für den Absender • Copy for sender" },
    { n: 2, cls: "egz-2", name: "EGZEMPLARZ DLA ODBIORCY", desc: "Exemplar für den Empfänger • Copy for consignee" },
    { n: 3, cls: "egz-3", name: "EGZEMPLARZ DLA PRZEWOŹNIKA", desc: "Exemplar für den Frachtführer • Copy for carrier" },
    { n: 4, cls: "egz-4", name: "EGZEMPLARZ ROZLICZENIOWY PRZEWOŹNIKA", desc: "Exemplar für Abrechnung • Copy for carrier accounting" }
  ];

  const DEFAULT_CARRIER_SIGN = "Agnieszka Sokołowska, Piotr Sokołowski Transport Ciężarowy S.C. (ul. Przemysłowa 7/2, 14-260 Lubawa, NIP: 744-527-12-70)";

  const appState = {
    mode: "cmr",
    copyFilter: "all",
    cmr: {
      cmr_no: "",
      cmr_1: "",
      cmr_2: "",
      cmr_3: "",
      cmr_4: "",
      cmr_5: "",
      cmr_16: "",
      cmr_17: "",
      cmr_18: "",
      cmr_19: "",
      cmr_21: "",
      cmr_22: ""
    },
    cargo: Array.from({ length: 5 }, () => ({
      marks: "",
      qty: "",
      pack: "",
      goods: "",
      stat: "",
      weight: "",
      vol: "",
      adr: ""
    })),
    cmrSig: "",
    order: {
      ord_no: "",
      ord_date: "",
      ord_client: "",
      ord_carrier: "",
      ord_cargo: "",
      ord_vehicle: "",
      ord_remarks: "",
      ord_terms: "",
      ord_net: "",
      ord_vat: "23",
      ord_pay_terms: "",
      ord_client_sign: "",
      ord_carrier_sign: DEFAULT_CARRIER_SIGN
    },
    actions: [
      { kind: "załadunek", placeDate: "", contact: "" },
      { kind: "rozładunek", placeDate: "", contact: "" }
    ],
    orderSig: ""
  };

  function esc(str) {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function fmtNum(n) {
    const val = Number.isFinite(n) ? n : 0;
    return val.toLocaleString("pl-PL", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function toNum(v) {
    if (typeof v === "number") return Number.isFinite(v) ? v : 0;
    const n = parseFloat(String(v || "").replace(/\s+/g, "").replace(",", "."));
    return Number.isFinite(n) ? n : 0;
  }

  function autoFitText(el, maxPt, minPt) {
    if (!el || !el.parentElement) return;
    let pt = maxPt;
    el.style.fontSize = pt + "pt";
    el.style.lineHeight = "1.15";
    const maxH = Math.max(12, el.parentElement.clientHeight - 15);
    let i = 0;
    while (pt > minPt && i < 40) {
      if (el.scrollHeight <= maxH + 1 && el.scrollWidth <= el.clientWidth + 1) break;
      pt = Math.max(minPt, +(pt - 0.35).toFixed(2));
      el.style.fontSize = pt + "pt";
      i++;
    }
  }

  function runAutoFit() {
    requestAnimationFrame(() => {
      document.querySelectorAll("[data-max-pt]").forEach((el) => {
        const maxPt = parseFloat(el.getAttribute("data-max-pt")) || 9;
        const minPt = parseFloat(el.getAttribute("data-min-pt")) || 6.4;
        autoFitText(el, maxPt, minPt);
      });
    });
  }

  window.setMode = function(m) {
    appState.mode = m;
    const isCmr = m === "cmr";
    document.getElementById("btnTabCmr").classList.toggle("active", isCmr);
    document.getElementById("btnTabOrder").classList.toggle("active", !isCmr);
    document.getElementById("formCmr").style.display = isCmr ? "block" : "none";
    document.getElementById("formOrder").style.display = isCmr ? "none" : "block";
    document.getElementById("copyFilter").style.display = isCmr ? "inline-block" : "none";
    document.getElementById("cmrPreview").style.display = isCmr ? "flex" : "none";
    document.getElementById("orderPreview").style.display = isCmr ? "none" : "flex";
    runAutoFit();
  };

  window.changeCopyFilter = function() {
    appState.copyFilter = document.getElementById("copyFilter").value;
    drawCmrPages();
  };

  window.addCargoItem = function() {
    appState.cargo.push({ marks: "", qty: "", pack: "", goods: "", stat: "", weight: "", vol: "", adr: "" });
    drawCargoForm();
    drawCmrPages();
  };

  window.removeCargoItem = function(index) {
    if (appState.cargo.length <= 1) return;
    appState.cargo.splice(index, 1);
    drawCargoForm();
    drawCmrPages();
  };

  window.updateCargoVal = function(index, key, val) {
    if (!appState.cargo[index]) return;
    appState.cargo[index][key] = val;
    refreshCargoTotals();
    document.querySelectorAll(`[data-cg-r="${index}"][data-cg-c="${key}"]`).forEach((el) => {
      if (el.value !== val) el.value = val;
    });
    runAutoFit();
  };

  function refreshCargoTotals() {
    let w = 0;
    let v = 0;
    appState.cargo.forEach((row) => {
      w += toNum(row.weight);
      v += toNum(row.vol);
    });
    document.getElementById("sumCargoCount").textContent = String(appState.cargo.length);
    document.getElementById("sumCargoWeight").textContent = fmtNum(w) + " kg";
    document.getElementById("sumCargoVol").textContent = fmtNum(v) + " m³";
  }

  function drawCargoForm() {
    const host = document.getElementById("cargoEditorContainer");
    if (!host) return;
    host.innerHTML = appState.cargo.map((row, i) => `
      <div class="item-card">
        <div class="item-card-top">
          <span>Pozycja ładunku ${i + 1}</span>
          ${appState.cargo.length > 1 ? `<button type="button" class="btn" style="padding:2px 7px;font-size:10px;" onclick="removeCargoItem(${i})">Usuń</button>` : ""}
        </div>
        <div class="row-2">
          <div class="inp-box">
            <label>6. Cechy i numery</label>
            <input type="text" value="${esc(row.marks)}" oninput="updateCargoVal(${i}, 'marks', this.value)" />
          </div>
          <div class="inp-box">
            <label>7. Ilość sztuk</label>
            <input type="text" value="${esc(row.qty)}" oninput="updateCargoVal(${i}, 'qty', this.value)" />
          </div>
        </div>
        <div class="row-2">
          <div class="inp-box">
            <label>8. Sposób opakowania</label>
            <input type="text" value="${esc(row.pack)}" oninput="updateCargoVal(${i}, 'pack', this.value)" />
          </div>
          <div class="inp-box">
            <label>9. Rodzaj towaru</label>
            <input type="text" value="${esc(row.goods)}" oninput="updateCargoVal(${i}, 'goods', this.value)" />
          </div>
        </div>
        <div class="row-3">
          <div class="inp-box">
            <label>11. Waga brutto (kg)</label>
            <input type="text" value="${esc(row.weight)}" oninput="updateCargoVal(${i}, 'weight', this.value)" />
          </div>
          <div class="inp-box">
            <label>12. Objętość (m³)</label>
            <input type="text" value="${esc(row.vol)}" oninput="updateCargoVal(${i}, 'vol', this.value)" />
          </div>
          <div class="inp-box">
            <label>13. ADR</label>
            <input type="text" value="${esc(row.adr)}" oninput="updateCargoVal(${i}, 'adr', this.value)" />
          </div>
        </div>
      </div>
    `).join("");
    refreshCargoTotals();
  }

  function drawCmrPages() {
    const host = document.getElementById("cmrPreview");
    if (!host) return;

    const list = appState.copyFilter === "all"
      ? COPIES
      : COPIES.filter((c) => String(c.n) === appState.copyFilter);

    const rowsHtml = appState.cargo.map((row, i) => `
      <tr>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.5" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="marks" oninput="updateCargoVal(${i}, 'marks', this.value)">${esc(row.marks)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.5" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="qty" oninput="updateCargoVal(${i}, 'qty', this.value)">${esc(row.qty)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.5" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="pack" oninput="updateCargoVal(${i}, 'pack', this.value)">${esc(row.pack)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.5" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="goods" oninput="updateCargoVal(${i}, 'goods', this.value)">${esc(row.goods)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.3" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="stat" oninput="updateCargoVal(${i}, 'stat', this.value)">${esc(row.stat)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.5" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="weight" oninput="updateCargoVal(${i}, 'weight', this.value)">${esc(row.weight)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.5" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="vol" oninput="updateCargoVal(${i}, 'vol', this.value)">${esc(row.vol)}</textarea></td>
        <td><textarea class="cmr-goods-inp" data-max-pt="8.3" data-min-pt="6.2" data-cg-r="${i}" data-cg-c="adr" oninput="updateCargoVal(${i}, 'adr', this.value)">${esc(row.adr)}</textarea></td>
      </tr>
    `).join("");

    const sigBlock = appState.cmrSig
      ? `<img src="${appState.cmrSig}" alt="Podpis nadawcy" class="sig-preview-img" />`
      : "";

    host.innerHTML = list.map((copy) => `
      <article class="cmr-page ${copy.cls}">
        <div>
          <div class="cmr-top-strip">
            <div class="cmr-strip-box">
              <span>Do wypełnienia pod odpowiedzialnością nadawcy / Auszufüllen unter der Verantwortung des Absenders / To be completed on the sender's responsibility</span>
              <span class="cmr-strip-tag">1–15 włącznie / einschl. / incl.</span>
            </div>
            <div class="cmr-strip-box">
              <span>Rubryki obwiedzione tłustymi liniami wypełnia przewoźnik / Die mit fett gedruckten Linien eingerahmten Rubriken müssen vom Frachtführer ausgefüllt werden</span>
              <span class="cmr-strip-tag">16+17+18+19+20</span>
            </div>
          </div>

          <header class="cmr-head">
            <div class="cmr-head-left">
              <div class="cmr-head-title-wrap">
                <span class="cmr-oval-badge">CMR</span>
