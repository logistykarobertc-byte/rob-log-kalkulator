    initPad("padCmr", "cmrSig");
    initPad("padOrder", "orderSig");
    wireInputs();
    runAutoFit();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
